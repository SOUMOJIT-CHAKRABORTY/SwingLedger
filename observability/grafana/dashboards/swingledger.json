{
  "uid": "swingledger-overview", "title": "SwingLedger - Application Overview",
  "description": "HTTP, JVM and database pool metrics. No host or PostgreSQL query exporter is installed.",
  "tags": ["swingledger"], "timezone": "browser", "schemaVersion": 40, "version": 1,
  "refresh": "30s", "time": {"from": "now-1h", "to": "now"},
  "annotations": {"list": []}, "templating": {"list": []},
  "panels": [
    {"id":1,"title":"Application scrape availability","description":"1 means Prometheus can scrape the application; this is not database readiness.","type":"stat","gridPos":{"x":0,"y":0,"w":12,"h":6},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"up{job=\"swingledger\"}"}],"fieldConfig":{"defaults":{"min":0,"max":1},"overrides":[]}},
    {"id":2,"title":"Request throughput","type":"timeseries","gridPos":{"x":12,"y":0,"w":12,"h":6},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(rate(http_server_requests_seconds_count{job=\"swingledger\",application=\"swingledger\",uri!~\"/actuator.*|/health\"}[$__rate_interval]))"}],"fieldConfig":{"defaults":{"unit":"reqps"},"overrides":[]}},
    {"id":3,"title":"HTTP 5xx percentage","description":"4xx responses are not counted as server failures; no traffic may show no data.","type":"timeseries","gridPos":{"x":0,"y":6,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"100 * sum(rate(http_server_requests_seconds_count{job=\"swingledger\",application=\"swingledger\",uri!~\"/actuator.*|/health\",status=~\"5..\"}[$__rate_interval])) / clamp_min(sum(rate(http_server_requests_seconds_count{job=\"swingledger\",application=\"swingledger\",uri!~\"/actuator.*|/health\"}[$__rate_interval])), 0.000001)"}],"fieldConfig":{"defaults":{"unit":"percent"},"overrides":[]}},
    {"id":4,"title":"HTTP p95 latency by route","type":"timeseries","gridPos":{"x":12,"y":6,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"histogram_quantile(0.95, sum by (le, uri) (rate(http_server_requests_seconds_bucket{job=\"swingledger\",application=\"swingledger\",uri!~\"/actuator.*|/health\"}[$__rate_interval])))","legendFormat":"{{uri}}"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":5,"title":"JVM heap used","type":"timeseries","gridPos":{"x":0,"y":13,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(jvm_memory_used_bytes{job=\"swingledger\",application=\"swingledger\",area=\"heap\"})"}],"fieldConfig":{"defaults":{"unit":"bytes"},"overrides":[]}},
    {"id":6,"title":"JVM process CPU","description":"Application process CPU, not whole-server CPU.","type":"timeseries","gridPos":{"x":12,"y":13,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"100 * process_cpu_usage{job=\"swingledger\",application=\"swingledger\"}"}],"fieldConfig":{"defaults":{"unit":"percent"},"overrides":[]}},
    {"id":7,"title":"GC pause time per second","type":"timeseries","gridPos":{"x":0,"y":20,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"sum(rate(jvm_gc_pause_seconds_sum{job=\"swingledger\",application=\"swingledger\"}[$__rate_interval]))"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}},
    {"id":8,"title":"Database connections active / maximum","type":"timeseries","gridPos":{"x":12,"y":20,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"hikaricp_connections_active{job=\"swingledger\",application=\"swingledger\"}","legendFormat":"{{pool}} active"},{"refId":"B","expr":"hikaricp_connections_max{job=\"swingledger\",application=\"swingledger\"}","legendFormat":"{{pool}} maximum"}]},
    {"id":9,"title":"Database connections waiting","type":"timeseries","gridPos":{"x":0,"y":27,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"hikaricp_connections_pending{job=\"swingledger\",application=\"swingledger\"}","legendFormat":"{{pool}}"}]},
    {"id":10,"title":"Database connection acquisition maximum","description":"Maximum in the meter window, not a percentile.","type":"timeseries","gridPos":{"x":12,"y":27,"w":12,"h":7},"datasource":{"type":"prometheus","uid":"prometheus"},"targets":[{"refId":"A","expr":"hikaricp_connections_acquire_seconds_max{job=\"swingledger\",application=\"swingledger\"}","legendFormat":"{{pool}}"}],"fieldConfig":{"defaults":{"unit":"s"},"overrides":[]}}
  ]
}
